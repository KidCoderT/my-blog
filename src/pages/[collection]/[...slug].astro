---
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { getPosts, tagUrl, vtName, fmtDate, edits, lastUpdated, historyUrl, GOATCOUNTER, type Post } from '../../posts'

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { collection: post.collection, slug: post.id }, props: { post } }))
}

const { post } = Astro.props as { post: Post }
const { Content, headings } = await render(post)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const { title, description, date, updated, tags } = post.data
const lastEdit = lastUpdated(post)
// revision trail: every edit day (git), or just the manual `updated:` if there's no git history
const trail = edits(post).length ? edits(post) : lastEdit ? [lastEdit] : []

// Giscus: make the repo public, enable Discussions, install https://github.com/apps/giscus,
// then copy the ids from https://giscus.app. Comments stay hidden until repoId is filled in.
const GISCUS = { repo: 'KidCoderT/my-blog', repoId: 'R_kgDOVU5QCA', category: 'Announcements', categoryId: 'DIC_kwDOVU5QCM4DJej6' }
---

<Base title={title} description={description}>
  <article class="post-grid">
    <header class="post-head">
      <h1><span class="vt-title" style={`view-transition-name:${vtName(post)}`}>{title}</span></h1>
      <div class="post-meta muted">
        <time datetime={date.toISOString()}>{fmtDate(date)}</time>
        {lastEdit && <span class="upd-pill">↻ updated {fmtDate(lastEdit)}</span>}
        {tags.map((t) => <a class="tag" href={tagUrl(t)}>#{t}</a>)}
      </div>
      {
        lastEdit && (
          <details class="revisions">
            <summary>history</summary>
            <ol>
              {trail.map((d) => (
                <li class="rev-edit"><time datetime={d.toISOString()}>{fmtDate(d)}</time> edited</li>
              ))}
              <li class="rev-created"><time datetime={date.toISOString()}>{fmtDate(date)}</time> created</li>
            </ol>
            <a class="rev-diffs" href={historyUrl(post)}>view diffs on GitHub →</a>
          </details>
        )
      }
    </header>

    {
      toc.length > 1 && (
        <nav class="toc" aria-label="Table of contents">
          <details open>
            <summary>On this page</summary>
            <ul>
              {toc.map((h) => (
                <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ul>
          </details>
        </nav>
      )
    }

    <div class="prose" data-pagefind-body>
      <Content />
    </div>
  </article>

  <footer class="end-mark" id="end-mark" data-gc={GOATCOUNTER}>
    <div class="end-rule" aria-hidden="true"><span class="end-spark">✦</span></div>
    <p class="end-thanks">That's all from me. Thanks for reading till the end!</p>
    <p class="end-views" id="end-views">&nbsp;</p>
  </footer>

  <script>
    // End mark: one twinkle when the reader gets here, plus this page's view count
    const end = document.getElementById('end-mark')!
    new IntersectionObserver(([e], io) => {
      if (e.isIntersecting) {
        end.classList.add('seen')
        io.disconnect()
      }
    }, { threshold: 0.6 }).observe(end)

    const views = document.getElementById('end-views')!
    if (end.dataset.gc) {
      fetch(`${end.dataset.gc}/counter/${encodeURIComponent(location.pathname)}.json`)
        .then((r) => (r.ok ? r.json() : Promise.reject()))
        .then(({ count }) => {
          views.textContent = count === '1' ? 'Read once' : `Read ${count} times`
          views.classList.add('loaded')
        })
        .catch(() => {})
    }
  </script>

  <script>
    // Hover copy button on every code block
    const COPY = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>'
    const DONE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>'
    for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
      const wrap = document.createElement('div')
      wrap.className = 'code-wrap'
      pre.replaceWith(wrap)
      wrap.append(pre)
      const btn = document.createElement('button')
      btn.type = 'button'
      btn.className = 'copy-btn'
      btn.ariaLabel = 'Copy code'
      btn.innerHTML = COPY
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText)
        } catch {
          return
        }
        btn.innerHTML = DONE
        btn.classList.add('copied')
        btn.ariaLabel = 'Copied'
        setTimeout(() => {
          btn.innerHTML = COPY
          btn.classList.remove('copied')
          btn.ariaLabel = 'Copy code'
        }, 1500)
      })
      wrap.append(btn)
    }
  </script>

  {
    GISCUS.repoId && (
      <section class="comments" id="comments" data-giscus={JSON.stringify(GISCUS)}>
        <script is:inline>
          // Load Giscus with the current light/dark theme; the header toggle keeps it in sync after.
          {
            const host = document.getElementById('comments')
            const s = document.createElement('script')
            s.src = 'https://giscus.app/client.js'
            s.async = true
            s.crossOrigin = 'anonymous'
            Object.assign(s.dataset, JSON.parse(host.dataset.giscus), {
              mapping: 'pathname', reactionsEnabled: '1', inputPosition: 'top', lang: 'en', loading: 'lazy',
              theme: document.documentElement.dataset.theme || 'light',
            })
            host.append(s)
          }
        </script>
      </section>
    )
  }
</Base>
