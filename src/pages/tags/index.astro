---
import Base from '../../layouts/Base.astro'
import { getPosts, tagUrl } from '../../posts'

const counts = new Map<string, number>()
for (const p of await getPosts()) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1)
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
---

<Base title="Tags">
  <h1 class="page-title">Tags</h1>
  <ul class="tag-cloud">
    {tags.map(([t, n]) => <li><a class="tag" href={tagUrl(t)}>#{t}<sup>{n}</sup></a></li>)}
  </ul>
</Base>
