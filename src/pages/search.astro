---
import Base from '../layouts/Base.astro'
import { url } from '../posts'

const bundle = url('pagefind/')
---

<Base title="Search">
  <h1 class="page-title">Search</h1>
  <link rel="stylesheet" href={`${bundle}pagefind-ui.css`} />
  <div id="search" class="search-box" data-bundle={bundle}></div>
  <noscript>Search needs JavaScript.</noscript>
  <script is:inline src={`${bundle}pagefind-ui.js`}></script>
  <script is:inline>
    {
      const el = document.getElementById('search')
      // Pagefind is generated by `npm run build`; in `npm run dev` it doesn't exist yet.
      if (window.PagefindUI) new PagefindUI({ element: el, bundlePath: el.dataset.bundle, showSubResults: true, autofocus: true })
      else el.textContent = 'Search is available after `npm run build` (try `npm run preview`).'
    }
  </script>
</Base>
